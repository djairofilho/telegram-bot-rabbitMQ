# Variáveis de ambiente para RabbitMQ e Telegram

# --- RabbitMQ ---
RABBITMQ_HOST=localhost           # Endereço do servidor RabbitMQ (ex: localhost, 127.0.0.1, ou IP do container)
RABBITMQ_PORT=5672                # Porta do RabbitMQ (padrão: 5672)
RABBITMQ_USER=guest               # Usuário do RabbitMQ (padrão: guest)
RABBITMQ_PASSWORD=guest           # Senha do RabbitMQ (padrão: guest)
RABBITMQ_QUEUE=minha_queue        # Nome da fila a ser consumida/publicada
RABBITMQ_EXCHANGE=minha_exchange  # Nome do exchange a ser utilizado (publicação)

# --- Telegram ---
TELEGRAM_TOKEN=seu_token_aqui     # Token do bot do Telegram (obtido com o BotFather)
TELEGRAM_CHAT_ID=seu_chat_id      # ID do chat ou grupo para envio das mensagens
